{
  "name": "qr-gen",
  "version": "1.0.0",
  "description": "Generador de códigos QR a partir de una URL, ejecutado íntegramente en el navegador.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild index.html style.css script.js icon.png --bundle --minify --format=iife --loader:.html=copy --loader:.png=copy --outdir=dist",
    "dev": "esbuild index.html style.css script.js icon.png --bundle --format=iife --loader:.html=copy --loader:.png=copy --outdir=dist --servedir=dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enol-mf/QR.Gen.git"
  },
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
